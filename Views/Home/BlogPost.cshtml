@model web_sitem.Models.BlogDetailViewModel

@{
    ViewData["Title"] = Model.Post.Title;
}

<div class="container py-5">
    <div class="content-card">
        @if (!string.IsNullOrWhiteSpace(Model.Post.ImageUrl))
        {
            <img class="detail-image" src="@Model.Post.ImageUrl" alt="@Model.Post.Title" loading="lazy" />
        }
        <span class="badge">@Model.Post.Category</span>
        <h1 class="display-5 mt-3">@Model.Post.Title</h1>
        <p class="text-muted">@Model.Post.PublishedAt.ToString("dd MMMM yyyy") · @Model.Post.ViewCount görüntülenme</p>
        <p class="lead">@Model.Post.Excerpt</p>

        <article class="mt-4">
            <p>@Model.Post.Content</p>
        </article>

        <a class="btn btn-outline-primary mt-4" asp-action="Blog">Tüm Belgeleri Gör</a>
    </div>

    <div class="section">
        <div class="section-title">
            <h2>Yorumlar</h2>
            <p>@Model.Comments.Count yorum</p>
        </div>

        <div class="content-card comment-form">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <form asp-action="SubmitComment" asp-route-slug="@Model.Post.Slug" method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Adınız</label>
                        <input asp-for="NewComment.Name" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">E-posta</label>
                        <input asp-for="NewComment.Email" class="form-control" type="email" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Yorumunuz</label>
                        <textarea asp-for="NewComment.Message" class="form-control" rows="4"></textarea>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Yorum Gönder</button>
            </form>
        </div>

        @if (Model.Comments.Any())
        {
            <div class="comment-list mt-4">
                @foreach (var comment in Model.Comments)
                {
                    <div class="content-card comment-card">
                        <div class="comment-meta">
                            <strong>@comment.Name</strong>
                            <span>@comment.CreatedAt.ToString("dd MMMM yyyy HH:mm")</span>
                        </div>
                        <p class="card-text mt-2">@comment.Message</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="content-card empty-state mt-4">
                <h3>Henüz yorum yok.</h3>
                <p>İlk yorumu siz bırakın.</p>
            </div>
        }
    </div>

    <div class="popular-section mt-5">
        <div class="section-title">
            <h2>En çok görüntülenenler</h2>
            <p>Benzer içerikler</p>
        </div>
        <div class="section-grid">
            @foreach (var post in Model.PopularPosts)
            {
                <div class="card h-100">
                    <div class="card-body">
                        <span class="badge">@post.Category</span>
                        <h3 class="card-title mt-3">@post.Title</h3>
                        <p class="card-text">@post.Summary</p>
                        <a class="btn btn-secondary mt-3" asp-action="BlogPost" asp-route-slug="@post.Slug">Oku</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
