@model IReadOnlyList<web_sitem.Models.ContactMessage>

@{
    ViewData["Title"] = "Gelen Mesajlar";
}

<div class="container py-5">
    <h1 class="display-5" data-i18n="inbox.title">Gelen Mesajlar</h1>
    <p class="lead" data-i18n="inbox.desc">Son iletişim talepleri ve mesajlar burada listelenir.</p>

    @if (!Model.Any())
    {
        <div class="alert alert-info" data-i18n="inbox.no-messages">Henüz yeni mesaj yok.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var message in Model)
            {
                <div class="list-group-item list-group-item-action mb-3 shadow-sm">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="mb-1">@message.Subject</h5>
                            <small>@message.Name · @message.Email</small>
                        </div>
                        <small class="text-muted">@message.ReceivedAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                    <p class="mt-3 mb-0">@message.Message</p>
                </div>
            }
        </div>
    }
</div>
