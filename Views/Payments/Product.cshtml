@{
    ViewData["Title"] = "Ürün - Ödeme Örneği";
}

<div class="container py-5">
    <div class="content-card">
        <h1>Örnek Ürün</h1>
        <p class="lead">Bu, Stripe Checkout ile ödemeyi demonstrasyon amaçlı gösteren basit bir ürün sayfasıdır.</p>
        <p>Fiyat: <strong>$50.00</strong></p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form asp-action="CreateCheckout" method="post">
            <input name="amountCents" type="hidden" value="5000" />
            <button type="submit" class="btn btn-primary">Stripe ile Öde</button>
        </form>

        <p class="mt-3 text-muted">(Gerçek anahtarlar appsettings.json içinde Stripe:SecretKey ve PublishableKey ile sağlanmalıdır.)</p>
    </div>
</div>