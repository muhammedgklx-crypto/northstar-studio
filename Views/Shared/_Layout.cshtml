<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Northstar Studio</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="theme-color" content="#0d6efd" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🌙%3C/text%3E%3C/svg%3E" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body class="site-body">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg container py-3">
            <a class="navbar-brand fw-bold" data-i18n="brand" asp-area="" asp-controller="Home" asp-action="Index">Northstar Studio</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" data-i18n="nav.home" asp-area="" asp-controller="Home" asp-action="Index">Anasayfa</a></li>
                    <li class="nav-item"><a class="nav-link" data-i18n="nav.about" asp-area="" asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                    <li class="nav-item"><a class="nav-link" data-i18n="nav.services" asp-area="" asp-controller="Home" asp-action="Services">Hizmetler</a></li>
                    <li class="nav-item"><a class="nav-link" data-i18n="nav.portfolio" asp-area="" asp-controller="Home" asp-action="Portfolio">Portföy</a></li>
                    <li class="nav-item"><a class="nav-link" data-i18n="nav.blog" asp-area="" asp-controller="Home" asp-action="Blog">Belgeler</a></li>
                    <li class="nav-item"><a class="nav-link" data-i18n="nav.products" asp-area="" asp-controller="Payments" asp-action="Product">Ürünler</a></li>
                    <li class="nav-item"><a class="nav-link" data-i18n="nav.contact" asp-area="" asp-controller="Home" asp-action="Contact">İletişim</a></li>
                    <li class="nav-item">
                        <button id="themeToggle" class="theme-toggle" type="button" title="Temayı değiştir" aria-label="Temayı değiştir">🌙</button>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="langMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-i18n="lang.menu">Dil</a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langMenu">
                            <li><a class="dropdown-item lang-select" href="#" data-lang="tr">Turkish</a></li>
                            <li><a class="dropdown-item lang-select" href="#" data-lang="en">English</a></li>
                        </ul>
                    </li>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" data-i18n="btn.panel" asp-area="" asp-controller="Admin" asp-action="Dashboard">Panel</a></li>
                        }
                        <li class="nav-item"><span class="nav-link text-light">@User.Identity.Name</span></li>
                        <li class="nav-item"><a class="nav-link" data-i18n="btn.logout" asp-controller="Account" asp-action="Logout">Çıkış</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" data-i18n="btn.login" asp-controller="Account" asp-action="Login">Giriş</a></li>
                        <li class="nav-item"><a class="nav-link btn-nav" data-i18n="btn.register" asp-controller="Account" asp-action="Register">Kayıt Ol</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p data-i18n="footer.copyright">&copy; 2026 Northstar Studio. Tüm hakları saklıdır.</p>
            <ul class="footer-links">
                <li><a data-i18n="footer.privacy" asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a></li>
                <li><a data-i18n="footer.support" asp-area="" asp-controller="Home" asp-action="Contact">Destek</a></li>
            </ul>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js?v=6"></script>
    <script>
        (function() {
            const button = document.getElementById('themeToggle');
            if (!button) {
                return;
            }

            const storedTheme = localStorage.getItem('site-theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = storedTheme || (prefersDark ? 'dark' : 'light');
            document.body.setAttribute('data-theme', theme);
            button.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
            button.textContent = theme === 'dark' ? '☀️' : '🌙';

            button.addEventListener('click', function() {
                const nextTheme = document.body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                document.body.setAttribute('data-theme', nextTheme);
                localStorage.setItem('site-theme', nextTheme);
                button.setAttribute('aria-pressed', nextTheme === 'dark' ? 'true' : 'false');
                button.textContent = nextTheme === 'dark' ? '☀️' : '🌙';
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


